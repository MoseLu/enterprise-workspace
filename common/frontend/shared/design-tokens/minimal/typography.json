/**
 * Minimal Theme Typography
 * Minimal 极简主题排版
 *
 * Design System: Enterprise Workspace
 * Theme: Minimal / Minimalist
 * Version: 1.0.0
 */

{
  "$schema": "https://schemas.style-dictionary.io/v4.0.0/schema.json",
  "minimal": {
    "typography": {
      "font-family": {
        "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "mono": "'JetBrains Mono', 'Fira Code', 'SF Mono', Monaco, Consolas, monospace"
      },
      "font-size": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "20px",
        "2xl": "24px",
        "3xl": "30px",
        "4xl": "36px"
      },
      "line-height": {
        "none": "1",
        "tight": "1.25",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625",
        "loose": "2"
      },
      "font-weight": {
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      },
      "letter-spacing": {
        "tighter": "-0.05em",
        "tight": "-0.025em",
        "normal": "0",
        "wide": "0.025em",
        "wider": "0.05em"
      }
    }
  }
}
