{
  "name": "@enterprise-workspace/react-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Workspace React 管理控制台 - 基于 AntD + Taro",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "prepare": "echo 'Husky disabled - manual checks only'",
    "preinstall": "echo 'Skipping only-allow check'",
    "dev": "node scripts/dev.mjs",
    "dev:app": "node scripts/dev.mjs --app",
    "dev:main": "node scripts/dev.mjs --app main-app",
    "dev:engineering": "node scripts/dev.mjs --app engineering-app",
    "dev:home": "node scripts/dev.mjs --app home-app",
    "dev:h5": "vite build --mode h5",
    "dev:weapp": "echo '请使用 Taro CLI: pnpm exec taro build --type weapp'",
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build.mjs --app",
    "build:main": "node scripts/build.mjs --app main-app",
    "build:engineering": "node scripts/build.mjs --app engineering-app",
    "build:home": "node scripts/build.mjs --app home-app",
    "build:all": "node scripts/build.mjs --all",
    "build:h5": "vite build --mode h5",
    "build:weapp": "echo '请使用 Taro CLI: pnpm exec taro build --type weapp'",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "lint": "eslint apps packages --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint apps packages --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@enterprise-workspace/frontend": "workspace:*",
    "@tarojs/taro": "^4.0.0",
    "@tarojs/components": "^4.0.0",
    "@tarojs/plugin-framework-react": "^4.0.0",
    "@tarojs/plugin-html": "^4.0.0",
    "@tarojs/plugin-platform-weapp": "^4.0.0",
    "@tarojs/runtime": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "happy-dom": "^12.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-mkcert": "^1.17.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "antd": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-router-dom": "^6.20.0"
  },
  "pnpm": {
    "overrides": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0",
      "react-router-dom": "^6.21.0",
      "typescript": "^5.9.3",
      "vite": "^5.4.21"
    }
  }
}
