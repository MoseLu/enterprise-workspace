{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV"
  ],
  "globalDependencies": [
    ".env"
  ],
  "pipeline": {
    "## ============================================ 构建任务 ============================================",
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        "!.turbo"
      ],
      "cache": true,
      "outputLogs": "new-only"
    },
    "## ============================================ 开发任务 ============================================",
    "dev": {
      "cache": false,
      "persistent": true
    },
    "## ============================================ 测试任务 ============================================",
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ],
      "cache": true
    },
    "test:ci": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "test-results/**"
      ],
      "cache": true
    },
    "## ============================================ 代码检查任务 ============================================",
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "lint-results/**"
      ],
      "cache": true
    },
    "lint:fix": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [],
      "cache": false
    },
    "## ============================================ 清理任务 ============================================",
    "clean": {
      "outputs": [],
      "cache": false
    },
    "clean:cache": {
      "outputs": [],
      "cache": false
    },
    "## ============================================ AI Studio任务 ============================================",
    "ai:generate": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "generated/**",
        "!generated/**/*.gitkeep"
      ],
      "cache": true
    },
    "ai:hot-update": {
      "outputs": [
        "hot-update/**"
      ],
      "cache": false
    },
    "ai:preview": {
      "cache": false,
      "persistent": true
    },
    "## ============================================ CI/CD任务 ============================================",
    "ci:validate": {
      "outputs": [],
      "cache": true
    },
    "ci:cache": {
      "outputs": [],
      "cache": false
    },
    "cd:deploy:test": {
      "dependsOn": [
        "^build",
        "^test"
      ],
      "outputs": [
        "deploy-artifacts/**"
      ],
      "cache": true
    },
    "cd:deploy:prod": {
      "dependsOn": [
        "^build",
        "^test",
        "^lint"
      ],
      "outputs": [
        "deploy-artifacts/**"
      ],
      "cache": true
    }
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "outputs": []
    }
  }
}
