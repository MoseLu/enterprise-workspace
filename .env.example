# ============================================
# 企业工作区环境变量示例配置
# ============================================
# 此文件包含所有开发环境所需的环境变量模板
# 复制此文件为 .env 并填写实际值后使用
# 注意：不要将此文件中的敏感信息提交到版本控制

## ============================================ 基础配置 ============================================
# 当前环境标识
NODE_ENV=development
# 项目名称
PROJECT_NAME=enterprise-workspace
# 项目版本
PROJECT_VERSION=1.0.0

## ============================================ 数据库配置 ============================================
# MySQL数据库连接配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=enterprise
MYSQL_USERNAME=root
MYSQL_PASSWORD=root
MYSQL_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# MySQL连接池配置
MYSQL_POOL_INITIAL_SIZE=5
MYSQL_POOL_MIN_IDLE=5
MYSQL_POOL_MAX_ACTIVE=50
MYSQL_POOL_MAX_WAIT=30000

## ============================================ Redis配置 ============================================
# Redis连接配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Redis连接池配置
REDIS_POOL_MAX_ACTIVE=50
REDIS_POOL_MAX_IDLE=20
REDIS_POOL_MIN_IDLE=5
REDIS_POOL_MAX_WAIT=3000

## ============================================ Nacos配置中心 ============================================
# Nacos服务器地址
NACOS_SERVER_ADDR=127.0.0.1
NACOS_SERVER_PORT=8848
# Nacos命名空间（按环境区分）
NACOS_NAMESPACE=development
# Nacos认证配置
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

## ============================================ 后端服务配置 ============================================
# 后端服务端口
SERVER_PORT=8080
# 后端服务上下文路径
SERVER_CONTEXT_PATH=/api
# 后端服务运行模式
SERVER_RUN_MODE=dev

# Spring Boot配置
SPRING_PROFILES_ACTIVE=dev
# Jackson日期格式
SPRING_JACKSON_DATE_FORMAT=yyyy-MM-dd HH:mm:ss
# 时区配置
SPRING_TIMEZONE=GMT+8

## ============================================ 前端配置 ============================================
# Taro多端前端配置
TARO_API_BASE_URL=http://localhost:8080
TARO_ENV=development

# PC中后台配置
PC_ADMIN_API_BASE_URL=http://localhost:8080
PC_ADMIN_ENV=development

## ============================================ AI Studio配置 ============================================
# AI Studio服务地址
AI_STUDIO_API_BASE_URL=http://localhost:3000
AI_STUDIO_BACKEND_URL=http://localhost:8080

# 代码生成配置
CODE_GENERATE_OUTPUT_DIR=./generated
CODE_GENERATE_TEMPLATE_DIR=./ai-studio/template

# 热更新配置
HOT_UPDATE_ENABLED=true
HOT_UPDATE_BACKUP_DIR=./backup/crud
HOT_UPDATE_CHECK_INTERVAL=5000

## ============================================ 安全配置 ============================================
# JWT密钥（请使用复杂的随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# API密钥（用于服务间调用）
API_KEY=your-api-key-change-in-production
API_SECRET=your-api-secret-change-in-production

## ============================================ 日志配置 ============================================
# 日志级别
LOG_LEVEL=debug
LOG_PATH=./logs
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

## ============================================ 文件上传配置 ============================================
# 上传文件临时目录
UPLOAD_TEMP_DIR=./temp/uploads
# 上传文件大小限制（MB）
UPLOAD_MAX_SIZE=50
# 允许的文件类型
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,gif,doc,docx,xls,xlsx,ppt,pptx,pdf,txt,zip,rar

## ============================================ 缓存配置 ============================================
# 缓存类型（local/redis）
CACHE_TYPE=local
# 本地缓存过期时间（秒）
CACHE_LOCAL_EXPIRE=3600
# Redis缓存过期时间（秒）
CACHE_REDIS_EXPIRE=7200

## ============================================ 跨域配置 ============================================
# 允许的跨域域名（开发环境）
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8001
# 允许的跨域方法
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# 允许的跨域头
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

## ============================================ 监控配置 ============================================
# 启用应用监控
MONITOR_ENABLED=true
# 监控端口
MONITOR_PORT=9090
# 健康检查端点
HEALTH_CHECK_URL=http://localhost:8080/api/health

## ============================================ 消息队列配置 ============================================
# RabbitMQ配置（可选）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

## ============================================ 对象存储配置 ============================================
# MinIO配置（可选）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123
MINIO_BUCKET=enterprise

## ============================================ 测试环境配置 ============================================
# 测试数据库配置
TEST_MYSQL_HOST=127.0.0.1
TEST_MYSQL_PORT=3306
TEST_MYSQL_DATABASE=enterprise_test
TEST_MYSQL_USERNAME=root
TEST_MYSQL_PASSWORD=root

# 测试Redis配置
TEST_REDIS_HOST=127.0.0.1
TEST_REDIS_PORT=6379

## ============================================ 第三方服务配置 ============================================
# GitHub配置（CI/CD使用）
GITHUB_TOKEN=your-github-token
GITHUB_REPO_OWNER=your-org
GITHUB_REPO_NAME=enterprise-workspace

# Docker镜像仓库配置
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-docker-username
DOCKER_PASSWORD=your-docker-password
DOCKER_IMAGE_PREFIX=enterprise

## ============================================ 部署配置 ============================================
# 部署目标环境
DEPLOY_ENV=development
# 部署服务器地址
DEPLOY_SERVER_HOST=
DEPLOY_SERVER_PORT=22
DEPLOY_SERVER_USERNAME=
DEPLOY_SERVER_PASSWORD=
# 部署路径
DEPLOY_TARGET_DIR=/opt/enterprise
# 备份路径
DEPLOY_BACKUP_DIR=/opt/enterprise/backup
